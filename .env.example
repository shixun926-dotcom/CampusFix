# 复制为 .env 后按实际情况修改（.env 不要提交到仓库）

# ---------- 数据库 ----------
MYSQL_DATABASE=campusfix
MYSQL_ROOT_PASSWORD=change-me-please
# 前端容器不暴露数据库端口；需要连库排查时在 compose 里放开 3307

# ---------- 端口 ----------
BACKEND_PORT=8080
FRONTEND_PORT=8081

# ---------- 安全 ----------
# 生产必须替换，长度不少于 32 字符
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# ---------- 跨域与资源地址 ----------
# 同源部署（前端 nginx 反代）保持默认即可
CORS_ALLOWED_ORIGINS=http://localhost:8081
STORAGE_PUBLIC_BASE_URL=
API_SERVER_URL=

# 前后端分域部署时才需要改：
# CORS_ALLOWED_ORIGINS=https://www.example.com
# STORAGE_PUBLIC_BASE_URL=https://api.example.com
# API_SERVER_URL=https://api.example.com
# VITE_API_BASE_URL=https://api.example.com/api/v1
# VITE_ASSET_BASE_URL=https://api.example.com

# ---------- 令牌存储 ----------
# memory = 单实例（默认）；redis = 多实例共享登录态
CACHE_TYPE=memory
